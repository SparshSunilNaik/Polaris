<?xml version="1.0"?>
<sdf version="1.9">
  <world name="antarctica">
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <scene>
      <grid>false</grid>
      <ambient>0.68 0.70 0.74 1</ambient>
      <background>0.58 0.68 0.80 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="antarctic_sun" type="directional">
      <pose>0 0 30 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1.15</intensity>
      <direction>-0.35 0.25 -0.90</direction>
      <diffuse>0.95 0.97 1.0 1</diffuse>
      <specular>0.35 0.35 0.38 1</specular>
    </light>

    <model name="snow_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <sensor name="ground_contacts" type="contact">
          <contact><collision>ground_collision</collision><topic>/polaris/world/contacts</topic></contact>
        </sensor>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.82 0.85 0.88 1</ambient>
            <diffuse>0.88 0.91 0.94 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Safe takeoff marker at the origin. Visual-only to preserve flat ground. -->
    <model name="takeoff_zone_marker">
      <static>true</static>
      <pose>0 0 0.012 0 0 0</pose>
      <link name="marker_link">
        <visual name="blue_pad">
          <geometry><box><size>3 3 0.02</size></box></geometry>
          <material>
            <ambient>0.05 0.20 0.55 1</ambient>
            <diffuse>0.08 0.30 0.85 1</diffuse>
          </material>
        </visual>
        <visual name="cross_x">
          <pose>0 0 0.015 0 0 0</pose>
          <geometry><box><size>2.2 0.25 0.025</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="cross_y">
          <pose>0 0 0.015 0 0 0</pose>
          <geometry><box><size>0.25 2.2 0.025</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Intentionally low-texture snowfield: x=-15, y=0, size 18x18 m. -->
    <model name="low_texture_snowfield">
      <static>true</static>
      <pose>-15 0 0.01 0 0 0</pose>
      <link name="snowfield_link">
        <visual name="snowfield_visual">
          <geometry><box><size>18 18 0.02</size></box></geometry>
          <material>
            <ambient>0.96 0.97 0.98 1</ambient>
            <diffuse>0.98 0.98 0.99 1</diffuse>
            <specular>0.18 0.18 0.18 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="snow_ridge_north">
      <static>true</static>
      <pose>-17 6.5 0.10 0 0 0.08</pose>
      <link name="ridge_link">
        <collision name="ridge_collision"><geometry><box><size>8 0.35 0.20</size></box></geometry></collision>
        <sensor name="ridge_contacts" type="contact"><contact><collision>ridge_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="ridge_visual">
          <geometry><box><size>8 0.35 0.20</size></box></geometry>
          <material><ambient>0.88 0.90 0.93 1</ambient><diffuse>0.92 0.94 0.96 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="snow_ridge_south">
      <static>true</static>
      <pose>-18 -6.0 0.08 0 0 -0.12</pose>
      <link name="ridge_link">
        <collision name="ridge_collision"><geometry><box><size>6 0.30 0.16</size></box></geometry></collision>
        <sensor name="ridge_contacts" type="contact"><contact><collision>ridge_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="ridge_visual">
          <geometry><box><size>6 0.30 0.16</size></box></geometry>
          <material><ambient>0.90 0.92 0.94 1</ambient><diffuse>0.94 0.95 0.97 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Feature-rich dark rock cluster in the northeast. -->
    <model name="rock_landmark_1">
      <static>true</static>
      <pose>8 10 0.75 0.10 0.18 0.35</pose>
      <link name="rock_link">
        <collision name="rock_collision"><geometry><box><size>2.4 1.6 1.5</size></box></geometry></collision>
        <sensor name="rock_contacts" type="contact"><contact><collision>rock_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="rock_visual">
          <geometry><box><size>2.4 1.6 1.5</size></box></geometry>
          <material><ambient>0.07 0.08 0.10 1</ambient><diffuse>0.12 0.14 0.17 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rock_landmark_2">
      <static>true</static>
      <pose>12 13 1.2 0 0 0</pose>
      <link name="rock_link">
        <collision name="rock_collision"><geometry><cylinder><radius>1.15</radius><length>2.4</length></cylinder></geometry></collision>
        <sensor name="rock_contacts" type="contact"><contact><collision>rock_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="rock_visual">
          <geometry><cylinder><radius>1.15</radius><length>2.4</length></cylinder></geometry>
          <material><ambient>0.10 0.09 0.08 1</ambient><diffuse>0.18 0.16 0.14 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rock_landmark_3">
      <static>true</static>
      <pose>16 9 1.1 -0.12 0.16 -0.45</pose>
      <link name="rock_link">
        <collision name="rock_collision"><geometry><box><size>3.0 2.1 2.2</size></box></geometry></collision>
        <sensor name="rock_contacts" type="contact"><contact><collision>rock_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="rock_visual">
          <geometry><box><size>3.0 2.1 2.2</size></box></geometry>
          <material><ambient>0.06 0.07 0.07 1</ambient><diffuse>0.10 0.12 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rock_landmark_4">
      <static>true</static>
      <pose>18 15 1.7 0 0 0</pose>
      <link name="rock_link">
        <collision name="rock_collision"><geometry><cylinder><radius>1.35</radius><length>3.4</length></cylinder></geometry></collision>
        <sensor name="rock_contacts" type="contact"><contact><collision>rock_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="rock_visual">
          <geometry><cylinder><radius>1.35</radius><length>3.4</length></cylinder></geometry>
          <material><ambient>0.08 0.10 0.12 1</ambient><diffuse>0.14 0.18 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rock_landmark_5">
      <static>true</static>
      <pose>11 17 0.55 0.18 -0.10 0.65</pose>
      <link name="rock_link">
        <collision name="rock_collision"><geometry><box><size>1.5 1.2 1.1</size></box></geometry></collision>
        <sensor name="rock_contacts" type="contact"><contact><collision>rock_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="rock_visual">
          <geometry><box><size>1.5 1.2 1.1</size></box></geometry>
          <material><ambient>0.14 0.12 0.10 1</ambient><diffuse>0.23 0.20 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Eastbound obstacle corridor. Interior width is 8 m. -->
    <model name="corridor_north_wall">
      <static>true</static>
      <pose>14 4.5 1.25 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision"><geometry><box><size>18 1 2.5</size></box></geometry></collision>
        <sensor name="wall_contacts" type="contact"><contact><collision>wall_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="wall_visual">
          <geometry><box><size>18 1 2.5</size></box></geometry>
          <material><ambient>0.06 0.18 0.30 1</ambient><diffuse>0.08 0.30 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="corridor_south_wall">
      <static>true</static>
      <pose>14 -4.5 1.25 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision"><geometry><box><size>18 1 2.5</size></box></geometry></collision>
        <sensor name="wall_contacts" type="contact"><contact><collision>wall_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="wall_visual">
          <geometry><box><size>18 1 2.5</size></box></geometry>
          <material><ambient>0.06 0.18 0.30 1</ambient><diffuse>0.08 0.30 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="corridor_offset_obstacle">
      <static>true</static>
      <pose>15 1.8 0.9 0 0 0.18</pose>
      <link name="obstacle_link">
        <collision name="obstacle_collision"><geometry><box><size>1.6 1.6 1.8</size></box></geometry></collision>
        <sensor name="obstacle_contacts" type="contact"><contact><collision>obstacle_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="obstacle_visual">
          <geometry><box><size>1.6 1.6 1.8</size></box></geometry>
          <material><ambient>0.65 0.20 0.03 1</ambient><diffuse>0.95 0.35 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- High-contrast gate at x=24 with a 5.2 m opening and 3.1 m clearance. -->
    <model name="navigation_gate">
      <static>true</static>
      <pose>24 0 0 0 0 0</pose>
      <link name="gate_link">
        <collision name="north_post_collision">
          <pose>0 3.35 1.65 0 0 0</pose>
          <geometry><box><size>0.8 1.5 3.3</size></box></geometry>
        </collision>
        <sensor name="north_post_contacts" type="contact"><contact><collision>north_post_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="north_post_visual">
          <pose>0 3.35 1.65 0 0 0</pose>
          <geometry><box><size>0.8 1.5 3.3</size></box></geometry>
          <material><ambient>0.85 0.55 0.02 1</ambient><diffuse>1.0 0.75 0.05 1</diffuse></material>
        </visual>
        <collision name="south_post_collision">
          <pose>0 -3.35 1.65 0 0 0</pose>
          <geometry><box><size>0.8 1.5 3.3</size></box></geometry>
        </collision>
        <sensor name="south_post_contacts" type="contact"><contact><collision>south_post_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="south_post_visual">
          <pose>0 -3.35 1.65 0 0 0</pose>
          <geometry><box><size>0.8 1.5 3.3</size></box></geometry>
          <material><ambient>0.85 0.55 0.02 1</ambient><diffuse>1.0 0.75 0.05 1</diffuse></material>
        </visual>
        <collision name="crossbar_collision">
          <pose>0 0 3.45 0 0 0</pose>
          <geometry><box><size>0.8 8.2 0.4</size></box></geometry>
        </collision>
        <sensor name="crossbar_contacts" type="contact"><contact><collision>crossbar_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="crossbar_visual">
          <pose>0 0 3.45 0 0 0</pose>
          <geometry><box><size>0.8 8.2 0.4</size></box></geometry>
          <material><ambient>0.85 0.55 0.02 1</ambient><diffuse>1.0 0.75 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Orange research-station surrogate southeast of takeoff. -->
    <model name="research_station_target">
      <static>true</static>
      <pose>12 -14 0 0 0 0</pose>
      <link name="station_link">
        <collision name="body_collision">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><box><size>7 5 3</size></box></geometry>
        </collision>
        <sensor name="body_contacts" type="contact"><contact><collision>body_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="body_visual">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><box><size>7 5 3</size></box></geometry>
          <material><ambient>0.58 0.10 0.02 1</ambient><diffuse>0.92 0.20 0.04 1</diffuse></material>
        </visual>
        <collision name="roof_collision">
          <pose>0 0 3.2 0 0 0</pose>
          <geometry><box><size>7.6 5.6 0.4</size></box></geometry>
        </collision>
        <sensor name="roof_contacts" type="contact"><contact><collision>roof_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="roof_visual">
          <pose>0 0 3.2 0 0 0</pose>
          <geometry><box><size>7.6 5.6 0.4</size></box></geometry>
          <material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.95 0.96 0.98 1</diffuse></material>
        </visual>
        <visual name="door_visual">
          <pose>-3.51 0 1.1 0 0 0</pose>
          <geometry><box><size>0.06 1.3 2.2</size></box></geometry>
          <material><ambient>0.02 0.28 0.34 1</ambient><diffuse>0.03 0.62 0.72 1</diffuse></material>
        </visual>
        <visual name="window_north_visual">
          <pose>-3.52 1.65 1.75 0 0 0</pose>
          <geometry><box><size>0.05 1.0 0.75</size></box></geometry>
          <material><ambient>0.02 0.12 0.25 1</ambient><diffuse>0.05 0.35 0.70 1</diffuse><emissive>0.02 0.10 0.25 1</emissive></material>
        </visual>
        <visual name="window_south_visual">
          <pose>-3.52 -1.65 1.75 0 0 0</pose>
          <geometry><box><size>0.05 1.0 0.75</size></box></geometry>
          <material><ambient>0.02 0.12 0.25 1</ambient><diffuse>0.05 0.35 0.70 1</diffuse><emissive>0.02 0.10 0.25 1</emissive></material>
        </visual>
        <collision name="mast_collision">
          <pose>1.8 0 4.35 0 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <sensor name="mast_contacts" type="contact"><contact><collision>mast_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="mast_visual">
          <pose>1.8 0 4.35 0 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Isolated physical centred-obstacle route: origin to NED N=-8, E=10. -->
    <model name="physical_centred_obstacle">
      <static>true</static>
      <pose>6 -4.8 1.6 0 0 0</pose>
      <link name="obstacle_link">
        <collision name="obstacle_collision">
          <geometry><box><size>1.8 1.8 3.2</size></box></geometry>
        </collision>
        <sensor name="obstacle_contacts" type="contact">
          <contact><collision>obstacle_collision</collision><topic>/polaris/world/contacts</topic></contact>
        </sensor>
        <visual name="obstacle_visual">
          <geometry><box><size>1.8 1.8 3.2</size></box></geometry>
          <material><ambient>0.55 0.04 0.04 1</ambient><diffuse>0.90 0.08 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Deterministic local glare target to the north. -->
    <model name="glare_panel">
      <static>true</static>
      <pose>-7 19 2.75 0 0 0</pose>
      <link name="panel_link">
        <collision name="panel_collision"><geometry><box><size>10 0.25 5.5</size></box></geometry></collision>
        <sensor name="panel_contacts" type="contact"><contact><collision>panel_collision</collision><topic>/polaris/world/contacts</topic></contact></sensor>
        <visual name="panel_visual">
          <geometry><box><size>10 0.25 5.5</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>1 1 1 1</specular>
            <emissive>0.75 0.75 0.70 1</emissive>
          </material>
        </visual>
      </link>
    </model>
    <light name="glare_test_light" type="point">
      <pose>-7 15 3.0 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>4.0</intensity>
      <diffuse>1.0 0.98 0.90 1</diffuse>
      <specular>1 1 1 1</specular>
      <attenuation>
        <range>14</range>
        <constant>0.8</constant>
        <linear>0.12</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
    </light>

    <!-- Separate visual-only landing marker beyond the gate. -->
    <model name="landing_zone_marker">
      <static>true</static>
      <pose>28 0 0.012 0 0 0</pose>
      <link name="marker_link">
        <visual name="green_pad">
          <geometry><box><size>4 4 0.02</size></box></geometry>
          <material><ambient>0.02 0.35 0.12 1</ambient><diffuse>0.04 0.70 0.22 1</diffuse></material>
        </visual>
        <visual name="h_left">
          <pose>0 -0.7 0.015 0 0 0</pose>
          <geometry><box><size>2.5 0.25 0.025</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="h_right">
          <pose>0 0.7 0.015 0 0 0</pose>
          <geometry><box><size>2.5 0.25 0.025</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="h_cross">
          <geometry><box><size>0.25 1.65 0.025</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
